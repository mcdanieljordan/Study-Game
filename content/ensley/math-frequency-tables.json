   "icon": "🔵",
   "lesson": [
    {
     "title": "What is a dot plot?",
     "html": "A <b>dot plot</b> uses <b>dots</b> above a number line. <b>Each dot is one piece of data.</b> The number with the most dots happened most often. The numbers with no dots didn't happen at all."
    },
    {
     "title": "Reading a dot plot",
     "html": "<b>Most often?</b> the tallest stack. <b>How many in all?</b> count every dot. <b>How many more?</b> count and subtract."
    }
   ],
