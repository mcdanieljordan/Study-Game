    {
     "q": "What does a frequency table show?",
     "a": "How many times each choice happens",
     "w": [
      "The biggest number only",
      "A picture of a graph",
      "Which choice is best"
     ],
     "why": "A frequency table counts how often each choice shows up."
    },
    {
     "q": "How many tally marks make one group with a slash?",
     "a": "5",
     "w": [
      "4",
      "10",
      "3"
     ],
     "why": "Four lines plus a slash across = 5."
    },
    {
     "q": "Four lines and a slash across them means…",
     "a": "5",
     "w": [
      "4",
      "6",
      "1"
     ],
     "why": "The slash is the 5th mark."
    },
    {
     "q": "A table says Red = 3, Blue = 7. What does the 7 tell you?",
     "a": "7 students chose blue",
     "w": [
      "Blue is the 7th color",
      "7 colors were picked",
      "Red is bigger"
     ],
     "why": "The Number column tells how many chose that color."
    }
