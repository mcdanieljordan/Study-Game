    {
     "q": "How can you find the number of classmates in a survey from a dot plot?",
     "a": "Add up all the dots",
     "w": [
      "Look at the tallest stack only",
      "Count the numbers on the line",
      "Add the numbers on the line"
     ],
     "why": "Count (add) the dots above each number."
    },
    {
     "q": "On a dot plot, what does the tallest stack of dots show?",
     "a": "The number that happened most often",
     "w": [
      "The biggest number",
      "The smallest number",
      "The total"
     ],
     "why": "More dots = it happened more often."
    },
    {
     "q": "If no classmates had 3 siblings, how would the dot plot change?",
     "a": "There would be no dots above the 3",
     "w": [
      "There would be a dot above 0",
      "The 3 would disappear from the number line",
      "Every stack would shrink"
     ],
     "why": "No data at 3 means no dots above 3."
    }
